% ---------------------------------------------------------
% de Vries / Rivero electroweak-angle numerology
% ---------------------------------------------------------

@misc{devries2004,
  author       = {de Vries, Hans},
  title        = {{Online post on the electroweak mixing-angle coincidence}},
  howpublished = {Physics Forums, thread ``All the lepton masses from $G,\pi,e$'' (started 4~Oct.\ 2004), post \#44},
  year         = {2004},
  month        = nov,
  url          = {https://www.physicsforums.com/showpost.php?p=382642&postcount=44},
  note         = {Earliest public statement (November 2004, per A.~Rivero's own account) of the empirical relation between $m_W/m_Z$ and $SU(2)$ isospin Casimirs, of the algebraic form $x^2+Jx-J=0$. The permalink was confirmed live and resolving to the original thread content at verification time (2026-07-02). Formally reported and dated in A.~Rivero, arXiv:hep-ph/0606171 [\texttt{rivero2006}], Sec.~3 (``The $\sin\theta_W$ found in a 1924 timecapsule''), and in the earlier joint preprint H.~de~Vries and A.~Rivero, arXiv:hep-ph/0503104, ``Evidence for radiative generation of lepton masses'' (2005). See refs\_notes.md.}
}

