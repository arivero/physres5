@article{rivero2006,
  author        = {Rivero, Alejandro},
  title         = {Mass terms to break susy-like degeneration},
  eprint        = {hep-ph/0606171},
  archivePrefix = {arXiv},
  year          = {2006},
  note          = {Collection of three notes on a Casimir-operator construction whose positive eigenvalues reproduce $s^2_{dV}=1-m^2_{1/2,+}/m^2_{1,+}=0.22310132\ldots$, close to the on-shell Weinberg angle. Section 3 documents and dates (November 2004) the Hans de~Vries Physics Forums post cited here as \texttt{devries2004}.}
}

