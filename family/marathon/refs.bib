% sBootstrap context (optional, requested if quickly verifiable)
% ---------------------------------------------------------

@article{rivero_sbootstrap,
  author        = {Rivero, Alejandro},
  title         = {Third Spectroscopy with a hint of superstrings},
  eprint        = {0710.1526},
  archivePrefix = {arXiv},
  year          = {2007},
  note          = {This is the correct arXiv identifier for what Rivero and others call the ``sBootstrap'' conjecture (grouping elementary fermions and composite QCD open strings into common supermultiplets, forcing three generations); confirmed via A.~Rivero's guest post ``sBootstrap'' on T.~Dorigo's blog (16 Oct 2007), which cites this preprint by number. The other candidate, hep-ph/0512065 (``Supersymmetry with composite bosons,'' Rivero, 2005), is a related precursor note but is not itself the sBootstrap paper -- see refs\_notes.md.}
}
